local function createESP(object, textName, color)
    if not object:FindFirstChild("NexusESP") then
        local hl = Instance.new("Highlight")
        hl.Name = "NexusESP"
        hl.Parent = object
        hl.FillColor = color
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.FillTransparency = 0.5

        local bill = Instance.new("BillboardGui")
        bill.Name = "NexusESPText"
        bill.Parent = object
        bill.Size = UDim2.new(0, 100, 0, 30)
        bill.StudsOffset = Vector3.new(0, 2, 0)
        bill.AlwaysOnTop = true

        local textLabel = Instance.new("TextLabel")
        textLabel.Parent = bill
        textLabel.BackgroundTransparency = 1
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Text = textName
        textLabel.TextColor3 = color
        textLabel.TextSize = 13
        textLabel.TextStrokeTransparency = 0.2
    end
end

local function removeESP(object)
    if object:FindFirstChild("NexusESP") then object.NexusESP:Destroy() end
    if object:FindFirstChild("NexusESPText") then object.NexusESPText:Destroy() end
end

